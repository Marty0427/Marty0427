<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  For exporting an archive with plain xcodebuild, when you are not using fastlane:

	    xcodebuild -project PocketPass.xcodeproj -scheme PocketPass -configuration Release \
	      -archivePath build/PocketPass.xcarchive archive
	    xcodebuild -exportArchive -archivePath build/PocketPass.xcarchive \
	      -exportOptionsPlist ExportOptions.plist -exportPath build -allowProvisioningUpdates

	  Replace TEAMID10CHR with your ten character Developer Portal team ID.
	-->
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>TEAMID10CHR</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>
